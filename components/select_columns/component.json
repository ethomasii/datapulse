{
  "id": "select_columns",
  "aliases": [
    "project_columns",
    "column_select"
  ],
  "name": "Select columns",
  "category": "transformation",
  "description": "Project a subset of columns via warehouse SQL (default) or dataframe.",
  "compileTarget": "warehouse",
  "fields": [
    {
      "key": "table",
      "label": "Table",
      "type": "string",
      "required": true
    },
    {
      "key": "columns",
      "label": "Columns",
      "type": "string_list",
      "required": true,
      "placeholder": "id, name, created_at"
    },
    {
      "key": "output_table",
      "label": "Output table",
      "type": "string"
    },
    {
      "key": "execution",
      "label": "Execution",
      "type": "select",
      "options": [
        "warehouse",
        "dataframe"
      ],
      "default": "warehouse"
    }
  ],
  "version": 1,
  "runtime": "eltpulse",
  "packageCompile": true,
  "compileArtifact": "compile.mjs"
}
