    {
      "key": "right_table",
      "label": "Right table",
      "type": "string",
      "required": true
    },
    {
      "key": "on",
      "label": "Join key(s)",
      "type": "string_list",
      "required": true
    },
    {
      "key": "output_table",
      "label": "Output table",
      "type": "string",
      "required": true
    },
    {
      "key": "execution",
      "label": "Execution",
      "type": "select",
      "options": [
        "warehouse",
        "dataframe"
      ],
      "default": "warehouse"
    }
  ],
  "version": 1,
  "runtime": "eltpulse",
  "packageCompile": true,
  "compileArtifact": "compile.mjs"
