{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/monitors",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/pipeline-schedules",
      "schedule": "* * * * *"
    },
    {
      "path": "/api/cron/managed-worker",
      "schedule": "*/5 * * * *"
    },
    {
      "path": "/api/cron/observability-alerts",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "api/compute/batch.py": {
      "maxDuration": 900,
      "memory": 3008,
      "excludeFiles": "{.next,*.cache,node_modules,public,app}/**"
    }
  },
  "rewrites": [
    {
      "source": "/eltpulse-compute/batch",
      "destination": "/api/compute/batch"
    },
    {
      "source": "/eltpulse-compute/health",
      "destination": "/api/compute/batch"
    }
  ]
}
