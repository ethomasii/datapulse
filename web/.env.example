# ============================================================
# eltPulse (web/) — copy to .env.local (Next.js loads .env.local automatically)
# Public / external: https://github.com/eltpulsehq/eltpulse
#
# Minimum to run the app with a database: set DATABASE_URL below (and Clerk keys).
# .env.local is gitignored — create it locally:  cp .env.example .env.local
# ============================================================

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ServicePulse (sibling product) — base URL for in-app links and ?eltpulse_origin= handoffs. Defaults to https://servicepulse.dev when unset.
# NEXT_PUBLIC_SERVICEPULSE_URL=https://servicepulse.dev

# --- DATABASE_URL (required) — Postgres for Prisma (pipelines, monitors, users, etc.) ---
# Database — Postgres connection URI (required for Prisma / npm run db:*)
# Shape: postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME
#
# If you use Neon (recommended for this app): https://console.neon.tech → your project →
# "Connection details" → copy "Connection string" (URI). Use the pooled string for serverless/Vercel if offered.
#
# If you use Postgres on your machine: same shape. Example for Docker:
#   docker run --name eltpulse-pg -e POSTGRES_PASSWORD=password -e POSTGRES_DB=eltpulse -p 5432:5432 -d postgres:16
# Then DATABASE_URL below matches user postgres, password password, db eltpulse.
DATABASE_URL="postgresql://postgres:password@localhost:5432/eltpulse"
# Same as DATABASE_URL when not using a pooler (local Docker / single Postgres).
DIRECT_URL="postgresql://postgres:password@localhost:5432/eltpulse"

# Neon: set DATABASE_URL to the pooled URI (…-pooler… in the host) and DIRECT_URL to the direct URI
# (same user/db/password; host without “-pooler”). Both are shown in Neon → Connect.
# DIRECT_URL="postgresql://USER:PASSWORD@ep-XXXX.region.aws.neon.tech/neondb?sslmode=require"

# Clerk — https://dashboard.clerk.com (required for sign-in; leave empty to use /dev-setup in local dev)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=whsec_...

NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/dashboard

# Stripe — https://dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRO_MONTHLY_PRICE_ID=price_...
STRIPE_TEAM_MONTHLY_PRICE_ID=price_...
# Optional: Stripe Billing Meter event name for usage-based row reporting (Dashboard → Billing → Meters)
# STRIPE_USAGE_METER_EVENT_NAME=rows_synced

# Resend — https://resend.com
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=notifications@eltpulse.dev
RESEND_FROM_NAME=eltPulse

# Anthropic — optional; for AI-assisted flows
ANTHROPIC_API_KEY=sk-ant-...

# Optional: Slack catalog discussions
# One-way (incoming webhook): new asset discussion threads post here
# SLACK_CATALOG_WEBHOOK_URL=https://hooks.slack.com/services/...
# Two-way (Bot + Events API): thread replies in Slack sync back to asset discussions
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_CATALOG_CHANNEL=C0123456789
# SLACK_SIGNING_SECRET=...
# Events URL: https://<app>/api/integrations/slack/events — subscribe to message.channels (or message.groups)

# Token encryption (connection secrets, OAuth tokens) — 32-byte key, base64-encoded
# ELTPULSE_TOKEN_ENCRYPTION_KEY=

# --- Internal APIs (managed worker + heartbeat) — production only unless testing locally ---
# Shared secret: Authorization: Bearer <value> for /api/internal/* (never expose to browsers).
# ELTPULSE_INTERNAL_API_SECRET=
# Optional absolute origin for cron self-calls (defaults to https://VERCEL_URL or NEXT_PUBLIC_APP_URL).
# ELTPULSE_CRON_APP_URL=http://localhost:3000

# --- Vercel Cron (/api/cron/*) — Vercel sends Authorization: Bearer <CRON_SECRET> on schedule ---
# CRON_SECRET=

# --- GitHub: managed repos (default product) ---
# eltPulse uses ONE GitHub App or machine user + your org (e.g. github.com/eltpulse-customers).
# Put installation ID / app credentials in server-only env (see code when commit automation lands).
# Customers authenticate only with eltPulse (Clerk), not with GitHub.

# --- Optional: let a customer connect THEIR GitHub (BYO) — off by default ---
# Set true only for experiments or enterprise “push to my org”.
CUSTOMER_GITHUB_OAUTH_ENABLED=false
# GitHub OAuth app (https://github.com/settings/developers) — callback:
# {NEXT_PUBLIC_APP_URL}/api/integrations/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- Managed execution (production real dlt/Sling/dbt runs) ---
# Default on Vercel is stub (demo telemetry). For real runs, set one of:
# ELTPULSE_MANAGED_EXECUTOR=gha   — dispatches .github/workflows/eltpulse-managed-worker.yml
# ELTPULSE_MANAGED_EXECUTOR=local — same-host Python/dlt/dbt (recommended local dev with secrets below)
# Local dev auto-selects `local` when ELTPULSE_INTERNAL_API_SECRET + ELTPULSE_TOKEN_ENCRYPTION_KEY are set.
# ELTPULSE_GITHUB_DISPATCH_TOKEN=  — PAT with Actions:write
# ELTPULSE_GITHUB_REPOSITORY=owner/datapulse
# ELTPULSE_INTERNAL_API_SECRET=    — required for workers to PATCH run progress
# ELTPULSE_TOKEN_ENCRYPTION_KEY=   — decrypt connection secrets for real runs
# ELTPULSE_DBT_BIN=dbt             — optional path to dbt CLI for local managed runs

# --- SaaS source OAuth (HubSpot, Salesforce, Shopify) — callback: /api/integrations/oauth/{connector}/callback ---
# ELTPULSE_OAUTH_STATE_SECRET=     — CSRF state signing (or reuse GITHUB_OAUTH_STATE_SECRET)
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# SALESFORCE_CLIENT_ID=
# SALESFORCE_CLIENT_SECRET=
# SALESFORCE_LOGIN_HOST=login.salesforce.com
# SHOPIFY_CLIENT_ID=
# SHOPIFY_CLIENT_SECRET=
# Optional: CPU/RAM telemetry on runs (agents + managed workers). Set 0 to disable.
# ELTPULSE_SYSTEM_METRICS=1
# ELTPULSE_SYSTEM_METRICS_INTERVAL_MS=20000
# Auto-push pipeline YAML to connected GitHub on save (default on; set false to disable)
# ELTPULSE_AUTO_GIT_PUSH=false
