// eltPulse — minimal SaaS schema (Clerk + Stripe + Neon)
// Extend with workspaces, pipelines, and run history as the product grows.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  /// Neon: use the non-pooled “direct” connection string. For local Postgres, set to the same value as `DATABASE_URL`.
  directUrl = env("DIRECT_URL")
}

enum PlanTier {
  free
  pro
  team
}

enum SubscriptionStatus {
  active
  trialing
  past_due
  canceled
  incomplete
  incomplete_expired
  paused
}

/// Who runs pipeline ingestion for this account. Telemetry (runs, logs) is always stored in eltPulse either way.
enum ExecutionPlane {
  /// Customer-operated execution (optional self-hosted agent token, CI, or control-plane API reporting).
  customer_agent
  /// eltPulse-operated managed execution (SaaS default).
  eltpulse_managed
  /// Legacy label on older databases; treated as `eltpulse_managed` in app logic. Migrated away by SQL migrations.
  datapulse_managed
}

/// How this run’s telemetry was produced / who executed ingestion. Distinct from `triggeredBy` (schedule, webhook, etc.).
enum RunIngestionExecutor {
  unspecified
  customer_agent
  eltpulse_managed
  /// Legacy label on older databases; treated as `eltpulse_managed` in app logic.
  datapulse_managed
  /// Logged-in app or session API (`/api/elt/runs`) reporting without the self-hosted agent.
  customer_control_plane
}

/// Per-pipeline default for who executes new runs (hybrid: some managed, some on your gateway).
enum PipelineExecutionHost {
  /// Follow account/org execution plane (`User.executionPlane`) for managed vs customer.
  inherit
  /// Force eltPulse-managed workers for this pipeline’s new runs.
  eltpulse_managed
  /// Force self-hosted gateway resolution (tokens / routing) for this pipeline’s new runs.
  customer_gateway
}

/// eltPulse-managed compute placement for an organization workspace.
enum ManagedComputeMode {
  /// Shared multi-tenant worker pool (default).
  shared
  /// Isolated worker fleet — no other org’s runs on the same queue/compute.
  dedicated
}

/// Where run metadata is primarily retained (air-gap v1 exports to customer webhook).
enum MetadataStorageMode {
  /// Default — run history and telemetry in eltPulse Cloud (Neon).
  cloud
  /// Mirror redacted run summaries to customer-controlled webhook; cloud retention still applies in v1.
  customer_export
}

model User {
  id        String   @id @default(cuid())
  clerkId   String   @unique
  email     String
  name      String?
  imageUrl  String?
  /// Optional HTTPS URL — POST when a pipeline run finishes (success or failure). No warehouse secrets in payload.
  runsWebhookUrl String? @db.Text
  /// Secret token for the incoming webhook trigger endpoint (POST /api/webhooks/trigger/:token).
  incomingWebhookToken String? @unique @db.Text
  /// Optional account-wide gateway Bearer token (polls pending runs, reports back). Omit for API-only, org token, or named-connector-only flows.
  agentToken String? @unique @db.Text
  /// Preferred execution plane; does not require `agentToken` when set to `customer_agent` (CI / app can still report runs).
  executionPlane ExecutionPlane @default(eltpulse_managed) @map("execution_plane")
  /// Last successful `POST /api/agent/heartbeat` (customer connector) or internal managed touch — survives serverless restarts.
  agentLastSeenAt      DateTime? @map("agent_last_seen_at")
  agentLastSeenVersion String?   @map("agent_last_seen_version")
  agentLastSeenLabels  Json      @default("{}") @map("agent_last_seen_labels")
  /// `customer_agent` = your process with Bearer token; `eltpulse_managed` = eltPulse-operated worker (SaaS / dedicated).
  agentLastSeenSource  String?   @map("agent_last_seen_source")
  /// Set when user clicks "Dismiss" on the dashboard onboarding checklist.
  onboardingDismissedAt DateTime? @map("onboarding_dismissed_at")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscription Subscription?
  eltPipelines EltPipeline[]
  githubConnection GithubConnection?
  eltPipelineRuns EltPipelineRun[]
  connections Connection[]
  eltMonitors EltMonitor[]
  catalogEntries CatalogEntry[]
  catalogAssetViews CatalogAssetView[]
  catalogCollections CatalogCollection[]
  glossaryTerms GlossaryTerm[]
  dataContracts DataContract[]
  catalogComments CatalogAssetComment[]
  dbtProjects DbtProject[]

  /// Membership in a shared org (not the owner row — use `ownedOrganization`).
  organizationId String?       @map("organization_id")
  organization   Organization? @relation("OrganizationMembers", fields: [organizationId], references: [id], onDelete: SetNull)
  /// Org this user owns (billing + org-level gateway defaults). At most one.
  ownedOrganization Organization? @relation("OrganizationOwner")
  /// When set, unrouted runs (no pipeline default, no per-run override) pin to this named gateway. Distinct from legacy `agentToken`.
  defaultAgentTokenId String?     @unique @map("default_agent_token_id")
  defaultAgentToken    AgentToken? @relation("UserAccountDefaultGateway", fields: [defaultAgentTokenId], references: [id], onDelete: SetNull)
  /// Default landing warehouse / lake for declarative `destination: @workspace` pipelines.
  defaultDestinationConnectionId String? @map("default_destination_connection_id")
  defaultDestinationConnection   Connection? @relation("UserDefaultDestination", fields: [defaultDestinationConnectionId], references: [id], onDelete: SetNull)
  /// GitHub catalog repos (`owner/repo` or raw URL) merged into component palette + compile resolution.
  componentCatalogUrls Json @default("[]") @map("component_catalog_urls")

  @@index([organizationId])
  @@index([defaultAgentTokenId])
  @@index([defaultDestinationConnectionId])
  /// Named agent connectors (AWS, GCP, on-prem, etc.) — each has its own Bearer token and heartbeat.
  agentTokens AgentToken[]
  workspaceApiKeys WorkspaceApiKey[]
  observabilityAlertRules ObservabilityAlertRule[]
  eltWorkflows EltWorkflow[]
  auditEvents WorkspaceAuditEvent[]
}

/// Per-user agent API token (multiple connectors: one per cloud, on-prem, etc.).
model AgentToken {
  id               String    @id @default(cuid())
  userId           String    @map("user_id")
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// When set, token is shared by this Clerk-linked org (Pro/Team). `userId` is the org owner for billing FK.
  organizationId   String?   @map("organization_id")
  organization     Organization? @relation("OrgScopedAgentTokens", fields: [organizationId], references: [id], onDelete: SetNull)
  name             String
  token            String    @unique @db.Text
  /// Optional labels, e.g. `{ "cloud": "aws", "site": "on-prem-dc1" }` for your own routing — not secret.
  metadata         Json      @default("{}")
  lastSeenAt       DateTime? @map("last_seen_at")
  lastSeenVersion  String?   @map("last_seen_version")
  lastSeenLabels   Json      @default("{}") @map("last_seen_labels")
  lastSeenSource   String?   @map("last_seen_source")
  revokedAt        DateTime? @map("revoked_at")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  /// Runs pinned to this gateway only (null on run = any gateway may execute).
  targetedRuns            EltPipelineRun[]
  /// Pipelines whose new runs default to this gateway unless overridden.
  pipelinesDefaultGateway EltPipeline[]  @relation("PipelineDefaultGateway")
  /// User who selected this token as account-level default for unrouted runs (at most one).
  userAccountDefaultFor User? @relation("UserAccountDefaultGateway")
  /// Org that selected this token as workspace default for unrouted runs (at most one org row).
  organizationAsWorkspaceDefault Organization? @relation("OrganizationDefaultGateway")

  @@index([userId])
  @@index([organizationId])
  @@map("AgentToken")
}

/// Shared workspace: billing tier follows the owner’s subscription; org-scoped gateway uses `agentToken`.
model Organization {
  id          String   @id @default(cuid())
  name        String
  /// Clerk Organization id when using Clerk orgs — optional until wired.
  clerkOrgId  String?  @unique @map("clerk_org_id")
  ownerUserId String   @unique @map("owner_user_id")
  owner       User     @relation("OrganizationOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  /// Bearer token for org-scoped gateways (same API as user `agentToken`).
  agentToken  String?  @unique @map("agent_token") @db.Text
  /// Named gateway default for unrouted runs when working in this org (Clerk org session).
  defaultAgentTokenId String?     @unique @map("default_agent_token_id")
  defaultAgentToken    AgentToken? @relation("OrganizationDefaultGateway", fields: [defaultAgentTokenId], references: [id], onDelete: SetNull)
  /// Org-wide default destination for declarative pipelines (`destination: @workspace`).
  defaultDestinationConnectionId String? @map("default_destination_connection_id")
  defaultDestinationConnection   Connection? @relation("OrganizationDefaultDestination", fields: [defaultDestinationConnectionId], references: [id], onDelete: SetNull)
  /// Optional floor for sensor checks (seconds). If set, overrides plan-tier default for this org (e.g. enterprise contract).
  sensorPollIntervalSecondsOverride Int? @map("sensor_poll_interval_seconds_override")
  /// Org-wide BYO component catalog repos (`owner/repo` or GitHub raw URL).
  componentCatalogUrls Json @default("[]") @map("component_catalog_urls")
  /// Shared vs dedicated eltPulse-managed worker fleet for this org.
  managedComputeMode ManagedComputeMode @default(shared) @map("managed_compute_mode")
  /// When `dedicated`: POST target for org-only worker batch (provisioned by eltPulse ops).
  managedWorkerBatchUrl String? @map("managed_worker_batch_url") @db.Text
  /// Stripe subscription for dedicated managed compute add-on (separate from workspace plan tier).
  dedicatedComputeStripeSubscriptionId String? @unique @map("dedicated_compute_stripe_subscription_id")
  dedicatedComputeSubscriptionStatus SubscriptionStatus? @map("dedicated_compute_subscription_status")
  dedicatedComputeCurrentPeriodEnd DateTime? @map("dedicated_compute_current_period_end")
  /// Air-gap v1 — export redacted run metadata to customer-controlled endpoint.
  metadataStorageMode MetadataStorageMode @default(cloud) @map("metadata_storage_mode")
  metadataExportWebhookUrl String? @map("metadata_export_webhook_url") @db.Text
  /// Optional shared secret — sent as `X-eltPulse-Signature` (HMAC-SHA256 hex of body).
  metadataExportWebhookSecret String? @map("metadata_export_webhook_secret") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  members User[] @relation("OrganizationMembers")
  orgScopedAgentTokens AgentToken[] @relation("OrgScopedAgentTokens")
  invites OrganizationInvite[]
  workspaceRuns EltPipelineRun[] @relation("RunWorkspaceOrganization")

  @@index([ownerUserId])
  @@index([defaultAgentTokenId])
  @@index([defaultDestinationConnectionId])
  @@index([managedComputeMode])
  @@map("Organization")
}

/// Optional: per-customer GitHub OAuth (BYO org). Disabled when using managed repos under eltPulse’s org only.
model GithubConnection {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  githubUserId     String
  githubLogin      String
  accessTokenEnc   String   @db.Text
  scope            String?
  defaultRepoOwner String?
  defaultRepoName  String?
  defaultBranch    String?  @default("main")
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([userId])
}

/// Named, reusable connection profile (source or destination). Referenced by monitors and pipelines (FK).
model Connection {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Human-readable label, e.g. "prod-postgres" or "bigquery-warehouse"
  name        String
  /// "source" | "destination"
  connectionType String
  /// Connector key, e.g. "postgres", "bigquery", "snowflake", "github"
  connector   String
  /// Non-secret config blob (schema, project_id, account, etc.).
  config      Json     @default("{}")
  /// AES-256-GCM ciphertext of JSON `Record<envKey, secretValue>` (catalog keys only). Optional: agent / future managed runners.
  connectionSecretsEnc String? @map("connection_secrets_enc") @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
  eltMonitors EltMonitor[]
  pipelinesAsSource      EltPipeline[] @relation("PipelineSourceConnection")
  pipelinesAsDestination EltPipeline[] @relation("PipelineDestinationConnection")
  dbtProjectsAsDestination DbtProject[] @relation("DbtProjectDestination")
  usersAsDefaultDestination User[] @relation("UserDefaultDestination")
  organizationsAsDefaultDestination Organization[] @relation("OrganizationDefaultDestination")
}

/// eltPulse monitor — evaluated on the control plane and/or your gateway depending on `executionHost` + account plane.
model EltMonitor {
  id               String    @id @default(cuid())
  userId           String
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  pipelineId       String    @map("pipeline_id")
  pipeline         EltPipeline @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  type             String
  config           Json      @default("{}")
  connectionId     String?
  connection       Connection? @relation(fields: [connectionId], references: [id], onDelete: SetNull)
  /// Hybrid: inherit account plane, force eltPulse cron, or force gateway-side evaluation only.
  executionHost    PipelineExecutionHost @default(inherit) @map("execution_host")
  lastCheckAt      DateTime?
  lastTriggeredAt  DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@unique([userId, name])
  @@index([userId])
  @@index([pipelineId])
  @@map("EltMonitor")
}

/// User-editable catalog metadata for assets, connectors, and dbt projects.
model CatalogEntry {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Stable key, e.g. pipeline:p1:raw:customers or dbt_project:p1
  assetKey    String   @map("asset_key")
  kind        String
  displayName String?  @map("display_name")
  description String?  @db.Text
  tags        Json     @default("[]")
  metadata    Json     @default("{}")
  pipelineId  String?  @map("pipeline_id")
  importedAt  DateTime? @map("imported_at")
  certifiedAt DateTime? @map("certified_at")
  certifiedById String? @map("certified_by_id")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, assetKey])
  @@index([userId])
  @@index([pipelineId])
  @@map("CatalogEntry")
}

/// Recently viewed catalog assets (per user).
model CatalogAssetView {
  id       String   @id @default(cuid())
  userId   String   @map("user_id")
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetKey String   @map("asset_key")
  viewedAt DateTime @default(now()) @map("viewed_at")

  @@unique([userId, assetKey])
  @@index([userId, viewedAt(sort: Desc)])
  @@map("CatalogAssetView")
}

/// Curated data product — a governed bundle of catalog assets (DataHub-style data product).
model CatalogCollection {
  id            String   @id @default(cuid())
  userId        String   @map("user_id")
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug          String
  name          String
  description   String?  @db.Text
  /// Product owner display name (team or person).
  ownerName     String?  @map("owner_name")
  /// Domain tag, e.g. finance, marketing, product.
  domain        String?
  /// Intended consumer teams or personas.
  consumerTags  Json     @default("[]") @map("consumer_tags")
  /// Optional linked data contract for SLA / schema guarantees.
  contractId    String?  @map("contract_id")
  contract      DataContract? @relation(fields: [contractId], references: [id], onDelete: SetNull)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  items         CatalogCollectionItem[]

  @@unique([userId, slug])
  @@index([userId])
  @@index([contractId])
  @@map("CatalogCollection")
}

model CatalogCollectionItem {
  id           String   @id @default(cuid())
  collectionId String   @map("collection_id")
  collection   CatalogCollection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  assetKey     String   @map("asset_key")
  sortOrder    Int      @default(0) @map("sort_order")

  @@unique([collectionId, assetKey])
  @@index([collectionId])
  @@map("CatalogCollectionItem")
}

/// Business glossary term linked to catalog assets.
model GlossaryTerm {
  id         String   @id @default(cuid())
  userId     String   @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  term       String
  definition String   @db.Text
  aliases    Json     @default("[]")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  links      GlossaryTermLink[]

  @@unique([userId, term])
  @@index([userId])
  @@map("GlossaryTerm")
}

model GlossaryTermLink {
  id         String   @id @default(cuid())
  termId     String   @map("term_id")
  term       GlossaryTerm @relation(fields: [termId], references: [id], onDelete: Cascade)
  assetKey   String   @map("asset_key")
  columnName String?  @map("column_name")

  @@unique([termId, assetKey, columnName])
  @@index([termId])
  @@index([assetKey])
  @@map("GlossaryTermLink")
}

/// Data contract — schema, freshness SLA, and ownership promises for catalog assets.
model DataContract {
  id                String   @id @default(cuid())
  userId            String   @map("user_id")
  user              User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  slug              String
  name              String
  description       String?  @db.Text
  ownerName         String?  @map("owner_name")
  ownerEmail        String?  @map("owner_email")
  status            String   @default("draft")
  /// Max hours since last successful pipeline run before contract is "stale".
  freshnessSlaHours Int?     @map("freshness_sla_hours")
  /// Expected columns: [{ name, type?, required?, description? }]
  schemaSpec        Json     @default("[]") @map("schema_spec")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  assets            DataContractAsset[]
  products          CatalogCollection[]

  @@unique([userId, slug])
  @@index([userId])
  @@map("DataContract")
}

model DataContractAsset {
  id         String   @id @default(cuid())
  contractId String   @map("contract_id")
  contract   DataContract @relation(fields: [contractId], references: [id], onDelete: Cascade)
  assetKey   String   @map("asset_key")

  @@unique([contractId, assetKey])
  @@index([contractId])
  @@index([assetKey])
  @@map("DataContractAsset")
}

/// Threaded discussion on a catalog asset (in-app; Slack mirror optional later).
model CatalogAssetComment {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  assetKey    String   @map("asset_key")
  body        String   @db.Text
  authorName  String?  @map("author_name")
  authorEmail String?  @map("author_email")
  parentId    String?  @map("parent_id")
  parent      CatalogAssetComment? @relation("CommentThread", fields: [parentId], references: [id], onDelete: Cascade)
  replies     CatalogAssetComment[] @relation("CommentThread")
  /// Slack thread anchor for two-way sync
  slackChannel String? @map("slack_channel")
  slackTs      String? @map("slack_ts")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([assetKey, createdAt(sort: Desc)])
  @@index([userId])
  @@map("CatalogAssetComment")
}

/// First-class dbt project — standalone or linked to one or more pipelines (Snowflake dbt Projects / dbt Cloud style).
model DbtProject {
  id                      String   @id @default(cuid())
  userId                  String   @map("user_id")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                    String
  description             String?  @db.Text
  /// Local path or subdirectory within a Git repo, e.g. ./eltpulse/dbt/analytics
  packagePath             String   @map("package_path")
  /// Full Git remote when project lives in a repo (optional if packagePath is sufficient)
  gitUrl                  String?  @map("git_url") @db.Text
  gitBranch               String?  @default("main") @map("git_branch")
  gitSubpath              String?  @map("git_subpath")
  targetSchema            String?  @map("target_schema")
  sourceSlug              String?  @map("source_slug")
  hubPackageKey           String?  @map("hub_package_key")
  runScope                String   @default("all") @map("run_scope")
  selector                String?
  scheduleEnabled         Boolean  @default(false) @map("schedule_enabled")
  cronSchedule            String?  @map("cron_schedule")
  scheduleTimezone        String   @default("UTC") @map("schedule_timezone")
  /// Warehouse for standalone dbt-only runs when no pipeline is linked
  destinationConnectionId String?  @map("destination_connection_id")
  destinationConnection   Connection? @relation("DbtProjectDestination", fields: [destinationConnectionId], references: [id], onDelete: SetNull)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")

  pipelines EltPipeline[]
  runs      EltPipelineRun[]

  @@unique([userId, name])
  @@index([userId])
  @@index([destinationConnectionId])
  @@map("DbtProject")
}

/// Generated ELT pipeline definitions stored in Neon.
model EltPipeline {
  id                  String   @id @default(cuid())
  userId              String
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name                String
  tool                String // "dlt" | "sling"
  enabled             Boolean  @default(true)
  sourceType          String
  destinationType     String
  description         String?
  groupName           String?
  sourceConfiguration Json     @default("{}")
  pipelineCode        String   @db.Text
  configYaml          String?  @db.Text
  /// eltPulse workspace manifest (scheduling, monitors, metadata). Stored as YAML text.
  workspaceYaml       String?  @map("workspace_yaml") @db.Text
  /// Optional: POST run events here for this pipeline only (overrides account default when set).
  runsWebhookUrl      String?  @db.Text
  /// New pending runs from triggers/API inherit this gateway unless a per-run override is set.
  defaultTargetAgentTokenId String?     @map("default_target_agent_token_id")
  defaultTargetAgentToken   AgentToken? @relation("PipelineDefaultGateway", fields: [defaultTargetAgentTokenId], references: [id], onDelete: SetNull)
  /// Hybrid execution: inherit account/org plane, force managed, or force customer gateway for new runs.
  executionHost PipelineExecutionHost @default(inherit) @map("execution_host")
  /// Saved source Connection row (non-secret config + optional secrets on Connection).
  sourceConnectionId String? @map("source_connection_id")
  sourceConnection   Connection? @relation("PipelineSourceConnection", fields: [sourceConnectionId], references: [id], onDelete: SetNull)
  /// Saved destination Connection row.
  destinationConnectionId String? @map("destination_connection_id")
  destinationConnection   Connection? @relation("PipelineDestinationConnection", fields: [destinationConnectionId], references: [id], onDelete: SetNull)
  /// Optional link to a workspace dbt project (config synced into sourceConfiguration.dbt).
  dbtProjectId            String? @map("dbt_project_id")
  dbtProject              DbtProject? @relation(fields: [dbtProjectId], references: [id], onDelete: SetNull)
  /// Authoritative declarative pipeline YAML (v2) when applied via GitOps or spec editor.
  declarativeSpecYaml     String? @map("declarative_spec_yaml") @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@unique([userId, name, tool])
  @@index([userId])
  @@index([sourceConnectionId])
  @@index([destinationConnectionId])
  @@index([dbtProjectId])
  runs EltPipelineRun[]
  eltMonitors EltMonitor[]
}

enum RunStatus {
  pending
  running
  succeeded
  failed
  cancelled
}

/// Execution records reported by runners, CI, or the app — structured logs only (no raw warehouse credentials).
model EltPipelineRun {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  pipelineId    String?
  pipeline      EltPipeline? @relation(fields: [pipelineId], references: [id], onDelete: Cascade)
  dbtProjectId  String?   @map("dbt_project_id")
  dbtProject    DbtProject? @relation(fields: [dbtProjectId], references: [id], onDelete: SetNull)
  /// Whether ingestion ran on the customer agent, managed eltPulse worker, or was reported via the control-plane API.
  ingestionExecutor RunIngestionExecutor @default(unspecified) @map("ingestion_executor")
  status        RunStatus @default(pending)
  environment   String    @default("default")
  correlationId String    @unique
  /// When set, only this named gateway (Bearer on `AgentToken`) may poll and PATCH this run; null = any gateway for this user.
  targetAgentTokenId String?    @map("target_agent_token_id")
  targetAgentToken   AgentToken? @relation(fields: [targetAgentTokenId], references: [id], onDelete: SetNull)
  /// Org workspace active when the run was enqueued (for dedicated managed compute routing).
  workspaceOrganizationId String? @map("workspace_organization_id")
  workspaceOrganization Organization? @relation("RunWorkspaceOrganization", fields: [workspaceOrganizationId], references: [id], onDelete: SetNull)
  triggeredBy   String?
  /// Slice / partition value for the executor (e.g. dlt `sys.argv[1]` / `partition_key`). Populated by API, monitors, or Run slices.
  partitionValue  String? @map("partition_value") @db.Text
  /// Warehouse column name for this slice when applicable (aligns with `backfill:partition:<column>:<value>`).
  partitionColumn String? @map("partition_column") @db.Text
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
  /// JSON array: [{ "at": ISO string, "level": "info"|"warn"|"error", "message": string }]
  logEntries    Json      @default("[]")
  /// JSON { "summary": { rowsLoaded?, bytesLoaded?, progress?, currentPhase?, currentResource?, updatedAt? }, "samples": [...] } — live + historical telemetry (gateway / managed worker PATCH).
  telemetry     Json      @default("{}")
  /// Sanitized error text for UI — never store connection strings or API keys here.
  errorSummary  String?   @db.Text
  webhookSentAt DateTime?
  webhookStatus String?
  airgapExportedAt DateTime? @map("airgap_exported_at")
  airgapExportStatus String? @map("airgap_export_status")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([userId, startedAt(sort: Desc)])
  @@index([workspaceOrganizationId, status])
  @@index([pipelineId, startedAt(sort: Desc)])
  @@index([dbtProjectId, startedAt(sort: Desc)])
  @@index([userId, status])
  @@index([userId, environment])
  @@index([userId, status, targetAgentTokenId])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  user                 User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  tier                 PlanTier           @default(free)
  status               SubscriptionStatus @default(active)
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  currentPeriodEnd     DateTime?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt
}

/// Personal API keys for HTTP automation (pipeline CRUD, run triggers).
model WorkspaceApiKey {
  id         String    @id @default(cuid())
  userId     String    @map("user_id")
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  name       String
  keyPrefix  String    @map("key_prefix")
  keyHash    String    @unique @map("key_hash") @db.Text
  scopes     String[]  @default(["pipelines:read", "pipelines:write", "runs:read", "runs:write", "connections:read", "connections:write"])
  lastUsedAt DateTime? @map("last_used_at")
  revokedAt  DateTime? @map("revoked_at")
  createdAt  DateTime  @default(now())

  @@index([userId])
  @@map("workspace_api_key")
}

/// Observability alert rule — success rate, freshness, row-drop thresholds.
model ObservabilityAlertRule {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean  @default(true)
  /// success_rate | freshness_hours | row_drop_pct | failed_runs
  metric      String
  /// lt | gt | lte | gte
  operator    String   @default("lt")
  threshold   Float
  windowDays  Int      @default(7) @map("window_days")
  pipelineId  String?  @map("pipeline_id")
  /// POST account runsWebhookUrl or per-pipeline override when triggered
  notifyWebhook Boolean @default(true) @map("notify_webhook")
  lastTriggeredAt DateTime? @map("last_triggered_at")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([userId])
  @@index([pipelineId])
  @@map("ObservabilityAlertRule")
}

/// Lightweight workflow DAG — pipeline chains after success (Lakeflow Jobs lite).
model EltWorkflow {
  id          String   @id @default(cuid())
  userId      String   @map("user_id")
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String
  enabled     Boolean  @default(true)
  description String?  @db.Text
  /// { nodes: [{ id, type: pipeline|monitor|webhook, pipelineId?, monitorId? }], edges: [{ from, to, on: success|failure|always }] }
  definition  Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@unique([userId, name])
  @@index([userId])
  @@map("EltWorkflow")
}

/// Pending email invites to join an organization workspace.
model OrganizationInvite {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String       @default("member")
  invitedAt      DateTime     @default(now()) @map("invited_at")
  acceptedAt     DateTime?    @map("accepted_at")

  @@unique([organizationId, email])
  @@index([organizationId])
  @@map("organization_invite")
}

/// Security-relevant workspace actions for compliance export (Account → Audit log).
model WorkspaceAuditEvent {
  id             String   @id @default(cuid())
  userId         String   @map("user_id")
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String?  @map("organization_id")
  actorEmail     String   @map("actor_email")
  action         String
  detail         Json     @default("{}")
  createdAt      DateTime @default(now()) @map("created_at")

  @@index([userId, createdAt(sort: Desc)])
  @@index([organizationId, createdAt(sort: Desc)])
  @@map("workspace_audit_event")
}
